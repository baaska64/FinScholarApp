import React, { useState } from 'react';
import { View, Text, TextInput, TouchableOpacity, ScrollView, Alert, Modal, Image } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { Calculator } from '../../utils/calculator';
import { useColorScheme } from 'nativewind';

const generateId = () => Math.random().toString(36).substr(2, 9);

function pctTier(pct: number) {
    if (pct >= 90) return 'text-green-500';
    if (pct >= 75) return 'text-blue-500';
    if (pct >= 60) return 'text-yellow-500';
    return 'text-red-500';
}

function pctTierBg(pct: number) {
    if (pct >= 90) return 'bg-green-500';
    if (pct >= 75) return 'bg-blue-500';
    if (pct >= 60) return 'bg-yellow-500';
    return 'bg-red-500';
}

export default function ActiveSubjectView({ subject, system, onChange, onBack }: any) {
    const { colorScheme } = useColorScheme();
    const isDark = colorScheme === 'dark';
    
    const [finOpen, setFinOpen] = useState(false);
    const [autoConfigOpen, setAutoConfigOpen] = useState(false);
    const [syllabusText, setSyllabusText] = useState('');

    const updateSubject = (updater: (s: any) => void) => {
        const newSubject = JSON.parse(JSON.stringify(subject));
        updater(newSubject);
        onChange(newSubject);
    };

    const res = Calculator.calculateSubject(subject, system);
    const passPct = Number(subject.passingPercent) || 60;
    const barW = res.hasData ? Math.max(0, Math.min(100, res.percent)) : 0;
    
    let pExplicit = 0, pBlank = 0;
    subject.periods.forEach((p: any) => { if (p.weight !== '' && p.weight !== null && p.weight !== undefined) pExplicit += Number(p.weight) || 0; else pBlank++; });
    const pAutoW = pBlank > 0 ? (Math.max(0, 100 - pExplicit) / pBlank) : 0;

    // Target GPA Logic
    const targetValue = subject.targetValue || passPct;
    const targetPercent = Number(targetValue); // Simplifying to percent for now
    const needed = targetPercent - res.absoluteEarned;
    const remainingWeight = res.absoluteAvailable;
    
    let targetMsg = "";
    let targetIcon = "";
    
    if (needed <= 0) {
        targetMsg = "You have reached your desired grade!";
        targetIcon = "checkmark-circle";
    } else if (remainingWeight <= 0 && needed > 0) {
        targetMsg = "All components are filled. Target cannot be reached.";
        targetIcon = "warning";
    } else if (needed > remainingWeight) {
        const passNeeded = passPct - res.absoluteEarned;
        if (passNeeded <= 0) {
            targetMsg = "Target is impossible, but you've already passed!";
            targetIcon = "alert-circle";
        } else if (passNeeded > remainingWeight) {
            targetMsg = "Target is impossible, and you cannot pass anymore.";
            targetIcon = "close-circle";
        } else {
            targetMsg = "Target is impossible, but you can still pass!";
            targetIcon = "warning";
        }
    } else {
        targetMsg = `You need ${needed.toFixed(1)} more points (out of remaining ${remainingWeight.toFixed(1)}%) to reach ${targetPercent.toFixed(1)}%.`;
        targetIcon = "locate";
    }

    const handleAutoConfig = () => {
        // Mock AutoConfig
        Alert.alert("AutoConfig", "Syllabus parsed! Added periods and components.");
        setAutoConfigOpen(false);
    };

    return (
        <View className="flex-1 pb-20">
            <View className="flex-row justify-between items-center mb-6">
                <TouchableOpacity onPress={onBack} className={`flex-row items-center px-4 py-2 rounded-full ${isDark ? 'bg-slate-800' : 'bg-blue-100'}`}>
                    <Ionicons name="chevron-back" size={14} color={isDark ? "#94a3b8" : "#3b82f6"} />
                    <Text className={`font-bold ml-2 ${isDark ? 'text-slate-300' : 'text-blue-600'}`}>Back</Text>
                </TouchableOpacity>
                <TouchableOpacity 
                    onPress={() => setAutoConfigOpen(true)}
                    className="flex-row items-center px-4 py-2 rounded-full bg-indigo-500 shadow-sm shadow-indigo-500"
                >
                    <Ionicons name="color-wand" size={14} color="#ffffff" />
                    <Text className="font-bold text-white ml-2">AutoConfig</Text>
                </TouchableOpacity>
            </View>

            {/* Subject Header Card */}
            <View className={`rounded-[32px] p-6 shadow-sm border mb-6 ${isDark ? 'bg-slate-800 border-slate-700' : 'bg-white border-blue-50 shadow-slate-200'}`}>
                <View className="flex-row justify-between items-start mb-6">
                    <View className="flex-1">
                        <View className={`self-start px-3 py-1.5 rounded-lg mb-3 ${isDark ? 'bg-slate-700' : 'bg-blue-50'}`}>
                            <Text className={`text-[10px] font-bold tracking-widest ${isDark ? 'text-slate-400' : 'text-blue-500'}`}>SUBJECT</Text>
                        </View>
                        <TextInput 
                            value={subject.name}
                            onChangeText={txt => updateSubject(s => s.name = txt)}
                            placeholder="Subject Name"
                            placeholderTextColor={isDark ? "#64748b" : "#94a3b8"}
                            className={`text-3xl font-extrabold p-0 m-0 ${isDark ? 'text-white' : 'text-slate-800'}`}
                        />
                    </View>
                    <TouchableOpacity onPress={() => setFinOpen(true)} className={`w-12 h-12 rounded-full items-center justify-center border-2 shadow-sm ${isDark ? 'bg-slate-900 border-blue-500' : 'bg-blue-50 border-blue-200'}`}>
                        <Image source={require('../../assets/images/FinLogo.png')} style={{width: 24, height: 24}} resizeMode="contain" />
                    </TouchableOpacity>
                </View>

                {/* Progress Bar */}
                <View className="mb-6">
                    <View className="flex-row justify-between items-end mb-2">
                        <Text className={`text-4xl font-extrabold ${isDark ? 'text-white' : 'text-slate-800'}`}>{res.hasData ? res.percent.toFixed(1) + '%' : '-'}</Text>
                        <View className={`rounded-xl px-4 py-2 ${isDark ? 'bg-slate-700' : 'bg-slate-100'}`}>
                            <Text className={`font-bold ${isDark ? 'text-slate-300' : 'text-slate-600'}`}>
                                {system === 'PERCENT' ? (res.hasData ? res.equivalent.toFixed(1) + '%' : 'No Data') : (res.hasData ? 'GWA: ' + res.equivalent.toFixed(2) : 'No Data')}
                            </Text>
                        </View>
                    </View>
                    <View className={`h-4 rounded-full overflow-hidden relative shadow-inner ${isDark ? 'bg-slate-900' : 'bg-slate-200'}`}>
                        <View className={`h-full rounded-full ${res.hasData ? pctTierBg(res.percent) : 'bg-slate-400'}`} style={{ width: `${barW}%` }} />
                        <View className="absolute h-full w-1 bg-white shadow-sm" style={{ left: `${passPct}%` }} />
                    </View>
                </View>

                {/* Target Tracker */}
                <View className={`p-4 rounded-2xl flex-row items-center mb-6 border ${isDark ? 'bg-indigo-900 border-indigo-500' : 'bg-indigo-50 border-indigo-100'}`}>
                    <Ionicons name={targetIcon as any} size={24} color={isDark ? "#818cf8" : "#6366f1"} style={{marginRight: 12}} />
                    <Text className={`flex-1 text-sm font-medium ${isDark ? 'text-indigo-200' : 'text-indigo-800'}`}>{targetMsg}</Text>
                </View>

                {/* Settings Row */}
                <View className="flex-row gap-4">
                    <View className="flex-1">
                        <Text className={`text-[10px] font-bold tracking-widest mb-2 ${isDark ? 'text-slate-400' : 'text-slate-500'}`}>UNITS</Text>
                        <TextInput 
                            keyboardType="numeric"
                            value={subject.units?.toString()}
                            onChangeText={txt => updateSubject(s => s.units = txt)}
                            className={`p-3 rounded-2xl font-bold border ${isDark ? 'bg-slate-900 text-white border-slate-700' : 'bg-slate-50 text-slate-800 border-slate-200'}`}
                        />
                    </View>
                    <View className="flex-1">
                        <Text className={`text-[10px] font-bold tracking-widest mb-2 ${isDark ? 'text-slate-400' : 'text-slate-500'}`}>PASS %</Text>
                        <TextInput 
                            keyboardType="numeric"
                            value={subject.passingPercent?.toString()}
                            onChangeText={txt => updateSubject(s => s.passingPercent = txt)}
                            className={`p-3 rounded-2xl font-bold border ${isDark ? 'bg-slate-900 text-white border-slate-700' : 'bg-slate-50 text-slate-800 border-slate-200'}`}
                        />
                    </View>
                    <View className="flex-1">
                        <Text className={`text-[10px] font-bold tracking-widest mb-2 ${isDark ? 'text-slate-400' : 'text-slate-500'}`}>TARGET</Text>
                        <TextInput 
                            keyboardType="numeric"
                            value={subject.targetValue?.toString()}
                            onChangeText={txt => updateSubject(s => s.targetValue = txt)}
                            placeholder="90"
                            placeholderTextColor={isDark ? "#475569" : "#94a3b8"}
                            className={`p-3 rounded-2xl font-bold border ${isDark ? 'bg-slate-900 text-white border-slate-700' : 'bg-slate-50 text-slate-800 border-slate-200'}`}
                        />
                    </View>
                </View>
            </View>

            {/* Periods */}
            {subject.periods.map((per: any, pIndex: number) => {
                const pd = Calculator.calculatePeriod(per, passPct);
                const pdGradeEq = Calculator.interpolateGrade(pd.percent, passPct, system);
                const pdDisplayGrade = system === 'PERCENT' ? pd.percent.toFixed(2) + '%' : pdGradeEq.toFixed(2);
                
                let cExplicit = 0, cBlank = 0;
                per.components.forEach((c: any) => { if (c.weight !== '' && c.weight !== null && c.weight !== undefined) cExplicit += Number(c.weight) || 0; else cBlank++; });
                const cAutoW = cBlank > 0 ? (Math.max(0, 100 - cExplicit) / cBlank) : 0;

                return (
                    <View key={per.id} className={`rounded-[28px] mb-6 shadow-sm border ${isDark ? 'bg-slate-800 border-slate-700' : 'bg-white border-slate-200'}`}>
                        {/* Period Header */}
                        <View className={`p-5 rounded-t-[28px] border-b flex-row justify-between items-center ${isDark ? 'bg-slate-800 border-slate-700' : 'bg-slate-50 border-slate-100'}`}>
                            <View className="flex-1 pr-4">
                                <Text className={`text-[10px] font-extrabold tracking-widest uppercase mb-1 ${isDark ? 'text-slate-400' : 'text-slate-500'}`}>PERIOD</Text>
                                <TextInput 
                                    value={per.name}
                                    onChangeText={txt => updateSubject(s => s.periods[pIndex].name = txt)}
                                    placeholder="Period Name"
                                    placeholderTextColor={isDark ? "#64748b" : "#94a3b8"}
                                    className={`text-xl font-bold p-0 m-0 ${isDark ? 'text-white' : 'text-slate-800'}`}
                                />
                            </View>
                            <View className="items-end">
                                <View className={`flex-row items-center rounded-xl px-3 py-1.5 mb-2 border ${isDark ? 'bg-slate-900 border-slate-700' : 'bg-white border-slate-200 shadow-sm shadow-slate-100'}`}>
                                    <Text className={`text-xs font-bold mr-2 ${isDark ? 'text-slate-400' : 'text-slate-400'}`}>Wt:</Text>
                                    <TextInput 
                                        keyboardType="numeric"
                                        placeholder={pAutoW.toFixed(1)}
                                        placeholderTextColor={isDark ? "#64748b" : "#cbd5e1"}
                                        value={per.weight?.toString()}
                                        onChangeText={txt => updateSubject(s => s.periods[pIndex].weight = txt)}
                                        className={`text-xs w-8 text-right p-0 font-bold ${isDark ? 'text-white' : 'text-slate-700'}`}
                                    />
                                    <Text className={`text-xs font-bold ml-1 ${isDark ? 'text-slate-400' : 'text-slate-400'}`}>%</Text>
                                </View>
                                {pd.hasData ? (
                                    <Text className={`text-lg font-extrabold ${pctTier(pd.percent)}`}>{pdDisplayGrade}</Text>
                                ) : (
                                    <Text className="text-slate-400 font-bold text-lg">-</Text>
                                )}
                            </View>
                        </View>

                        {/* Components */}
                        <View className="p-4">
                            {per.components.map((comp: any, cIndex: number) => {
                                let iExplicit = 0, iBlank = 0;
                                comp.items.forEach((i: any) => { if (i.weight !== '' && i.weight !== null && i.weight !== undefined) iExplicit += Number(i.weight) || 0; else iBlank++; });
                                const iAutoW = iBlank > 0 ? (Math.max(0, 100 - iExplicit) / iBlank) : 0;

                                return (
                                    <View key={comp.id} className={`mb-4 rounded-3xl p-4 border ${isDark ? 'bg-slate-900 border-slate-700' : 'bg-white border-slate-100 shadow-sm shadow-slate-100'}`}>
                                        <View className="flex-row justify-between items-center mb-4">
                                            <TextInput 
                                                value={comp.name}
                                                onChangeText={txt => updateSubject(s => s.periods[pIndex].components[cIndex].name = txt)}
                                                placeholder="Component Name"
                                                placeholderTextColor={isDark ? "#64748b" : "#94a3b8"}
                                                className={`text-base font-bold flex-1 p-0 ${isDark ? 'text-slate-200' : 'text-slate-700'}`}
                                            />
                                            <View className={`flex-row items-center rounded-lg px-2 py-1 ml-2 ${isDark ? 'bg-slate-800' : 'bg-slate-50'}`}>
                                                <Text className={`text-[10px] font-bold mr-1 ${isDark ? 'text-slate-500' : 'text-slate-400'}`}>Wt:</Text>
                                                <TextInput 
                                                    keyboardType="numeric"
                                                    placeholder={cAutoW.toFixed(1)}
                                                    placeholderTextColor={isDark ? "#64748b" : "#cbd5e1"}
                                                    value={comp.weight?.toString()}
                                                    onChangeText={txt => updateSubject(s => s.periods[pIndex].components[cIndex].weight = txt)}
                                                    className={`text-[10px] font-bold w-6 text-right p-0 ${isDark ? 'text-slate-300' : 'text-slate-600'}`}
                                                />
                                                <Text className={`text-[10px] font-bold ml-0.5 ${isDark ? 'text-slate-500' : 'text-slate-400'}`}>%</Text>
                                            </View>
                                        </View>

                                        {comp.items.map((item: any, iIndex: number) => {
                                            return (
                                                <View key={item.id} className={`flex-row items-center justify-between mb-2 pb-2 border-b ${isDark ? 'border-slate-800' : 'border-slate-50'}`}>
                                                    <TextInput 
                                                        value={item.name}
                                                        onChangeText={txt => updateSubject(s => s.periods[pIndex].components[cIndex].items[iIndex].name = txt)}
                                                        placeholder={`Item ${iIndex + 1}`}
                                                        placeholderTextColor={isDark ? "#475569" : "#cbd5e1"}
                                                        className={`text-xs font-medium flex-1 py-1 ${isDark ? 'text-slate-400' : 'text-slate-500'}`}
                                                    />
                                                    
                                                    <View className={`flex-row items-center mx-2 rounded-xl flex-2 px-3 py-1.5 border ${isDark ? 'bg-slate-800 border-slate-700' : 'bg-white border-slate-200 shadow-sm shadow-slate-100'}`}>
                                                        <TextInput 
                                                            keyboardType="numeric"
                                                            value={item.score?.toString()}
                                                            onChangeText={txt => updateSubject(s => s.periods[pIndex].components[cIndex].items[iIndex].score = txt)}
                                                            placeholder="-"
                                                            placeholderTextColor={isDark ? "#64748b" : "#94a3b8"}
                                                            className={`text-xs font-bold w-8 text-center py-0 ${isDark ? 'text-white' : 'text-slate-800'}`}
                                                        />
                                                        <Text className={`text-xs font-bold mx-1 ${isDark ? 'text-slate-600' : 'text-slate-300'}`}>/</Text>
                                                        <TextInput 
                                                            keyboardType="numeric"
                                                            value={item.max?.toString()}
                                                            onChangeText={txt => updateSubject(s => s.periods[pIndex].components[cIndex].items[iIndex].max = txt)}
                                                            placeholder="100"
                                                            placeholderTextColor={isDark ? "#64748b" : "#94a3b8"}
                                                            className={`text-xs font-bold w-8 text-center py-0 ${isDark ? 'text-slate-400' : 'text-slate-500'}`}
                                                        />
                                                    </View>

                                                    <View className="flex-row items-center">
                                                        <TextInput 
                                                            keyboardType="numeric"
                                                            value={item.weight?.toString()}
                                                            onChangeText={txt => updateSubject(s => s.periods[pIndex].components[cIndex].items[iIndex].weight = txt)}
                                                            placeholder={iAutoW.toFixed(1)}
                                                            placeholderTextColor={isDark ? "#64748b" : "#cbd5e1"}
                                                            className={`text-[10px] font-bold w-6 text-right py-1 ${isDark ? 'text-slate-400' : 'text-slate-500'}`}
                                                        />
                                                        <Text className={`text-[10px] font-bold ml-0.5 ${isDark ? 'text-slate-600' : 'text-slate-400'}`}>%</Text>
                                                        <TouchableOpacity 
                                                            onPress={() => updateSubject(s => s.periods[pIndex].components[cIndex].items.splice(iIndex, 1))}
                                                            className={`ml-3 p-1.5 rounded-full ${isDark ? 'bg-red-500' : 'bg-red-50'}`}
                                                        >
                                                            <Ionicons name="close" size={10} color="#ef4444" style={{ fontWeight: 'bold' }} />
                                                        </TouchableOpacity>
                                                    </View>
                                                </View>
                                            );
                                        })}
                                        <TouchableOpacity 
                                            onPress={() => updateSubject(s => s.periods[pIndex].components[cIndex].items.push({ id: generateId(), max: 100 }))}
                                            className={`mt-2 py-3 items-center rounded-xl border border-dashed ${isDark ? 'border-slate-700 bg-slate-800' : 'border-blue-200 bg-blue-50'}`}
                                        >
                                            <Text className="text-blue-500 text-xs font-bold">+ Add Item</Text>
                                        </TouchableOpacity>
                                    </View>
                                );
                            })}
                            <TouchableOpacity 
                                onPress={() => updateSubject(s => s.periods[pIndex].components.push({ id: generateId(), name: 'New Component', items: [] }))}
                                className={`py-4 items-center rounded-2xl mt-2 border-2 border-dashed ${isDark ? 'border-slate-700 bg-slate-800' : 'border-blue-200 bg-white'}`}
                            >
                                <Text className="text-blue-500 text-sm font-bold">+ Add Component</Text>
                            </TouchableOpacity>
                        </View>
                    </View>
                );
            })}
            
            <TouchableOpacity 
                onPress={() => updateSubject(s => s.periods.push({ id: generateId(), name: 'New Period', components: [] }))}
                className={`py-5 items-center rounded-3xl mb-12 border-2 border-dashed ${isDark ? 'border-slate-700 bg-slate-800' : 'border-blue-200 bg-white'}`}
            >
                <Text className="text-blue-500 text-base font-extrabold">+ Add Period</Text>
            </TouchableOpacity>

            {/* FinSights Modal */}
            <Modal visible={finOpen} animationType="slide" presentationStyle="pageSheet" onRequestClose={() => setFinOpen(false)}>
                <View className={`flex-1 pt-8 px-6 ${isDark ? 'bg-slate-900' : 'bg-blue-50'}`}>
                    <View className="flex-row justify-between items-center mb-8">
                        <View className="flex-row items-center">
                            <View className="w-12 h-12 rounded-full bg-white items-center justify-center shadow-sm mr-3">
                                <Image source={require('../../assets/images/FinLogo.png')} style={{width: 32, height: 32}} resizeMode="contain" />
                            </View>
                            <View>
                                <Text className={`text-2xl font-extrabold ${isDark ? 'text-white' : 'text-slate-800'}`}>FinSights</Text>
                                <Text className={isDark ? 'text-slate-400' : 'text-slate-500'}>Here's what I noticed...</Text>
                            </View>
                        </View>
                        <TouchableOpacity onPress={() => setFinOpen(false)} className={`p-3 rounded-full ${isDark ? 'bg-slate-800' : 'bg-white shadow-sm'}`}>
                            <Ionicons name="close" size={16} color={isDark ? "#94a3b8" : "#64748b"} style={{ fontWeight: 'bold' }} />
                        </TouchableOpacity>
                    </View>
                    
                    <View className={`p-6 rounded-[32px] shadow-sm mb-4 ${isDark ? 'bg-slate-800' : 'bg-white'}`}>
                        {res.hasData ? (
                            <View>
                                <View className="flex-row items-start mb-6">
                                    <Text className="text-2xl mr-3">{targetIcon === 'checkmark-circle' ? '🎉' : '🎯'}</Text>
                                    <Text className={`text-base font-medium flex-1 ${isDark ? 'text-slate-200' : 'text-slate-700'}`}>{targetMsg}</Text>
                                </View>
                                <View className="flex-row items-start">
                                    <Text className="text-2xl mr-3">💡</Text>
                                    <Text className={`text-base font-medium flex-1 ${isDark ? 'text-slate-200' : 'text-slate-700'}`}>
                                        Focus on upcoming heavily weighted items. Keep your momentum up!
                                    </Text>
                                </View>
                            </View>
                        ) : (
                            <View className="flex-row items-start">
                                <Text className="text-2xl mr-3">👋</Text>
                                <Text className={`text-base font-medium flex-1 ${isDark ? 'text-slate-200' : 'text-slate-700'}`}>
                                    Add some scores and I'll analyze your subject for you!
                                </Text>
                            </View>
                        )}
                    </View>
                </View>
            </Modal>

            {/* AutoConfig Modal */}
            <Modal visible={autoConfigOpen} animationType="slide" presentationStyle="pageSheet" onRequestClose={() => setAutoConfigOpen(false)}>
                <View className={`flex-1 pt-8 px-6 ${isDark ? 'bg-slate-900' : 'bg-slate-50'}`}>
                    <View className="flex-row justify-between items-center mb-8">
                        <View className="flex-row items-center">
                            <View className="w-12 h-12 rounded-full bg-indigo-100 items-center justify-center mr-3">
                                <Ionicons name="color-wand" size={24} color="#6366f1" />
                            </View>
                            <View>
                                <Text className={`text-2xl font-extrabold ${isDark ? 'text-white' : 'text-slate-800'}`}>AutoConfig</Text>
                                <Text className={isDark ? 'text-slate-400' : 'text-slate-500'}>Paste your syllabus below</Text>
                            </View>
                        </View>
                        <TouchableOpacity onPress={() => setAutoConfigOpen(false)} className={`p-3 rounded-full ${isDark ? 'bg-slate-800' : 'bg-white shadow-sm'}`}>
                            <Ionicons name="close" size={16} color={isDark ? "#94a3b8" : "#64748b"} style={{ fontWeight: 'bold' }} />
                        </TouchableOpacity>
                    </View>

                    <TextInput 
                        multiline 
                        value={syllabusText}
                        onChangeText={setSyllabusText}
                        placeholder="e.g. Midterm is 30%, Finals 40%, Quizzes 30%..."
                        placeholderTextColor={isDark ? "#64748b" : "#94a3b8"}
                        className={`flex-1 p-6 rounded-[32px] mb-6 text-base shadow-sm border ${isDark ? 'bg-slate-800 text-white border-slate-700' : 'bg-white text-slate-800 border-slate-100'}`}
                        style={{ textAlignVertical: 'top' }}
                    />

                    <TouchableOpacity 
                        onPress={handleAutoConfig}
                        className="bg-indigo-500 py-4 rounded-[32px] items-center mb-10 shadow-lg shadow-indigo-500"
                    >
                        <Text className="text-white font-bold text-lg">Parse & Build Ledger</Text>
                    </TouchableOpacity>
                </View>
            </Modal>
        </View>
    );
}

