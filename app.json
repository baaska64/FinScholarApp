{
  "expo": {
    "name": "FinScholarApp",
    "slug": "FinScholarApp",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/images/FinScholarAppLogo.png",
    "scheme": "finscholarapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/FinScholarAppLogo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "com.android.vending.BILLING"
      ],
      "package": "com.lalex.finscholar",
      "versionCode": 24
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/SplashIcon.png",
          "resizeMode": "contain",
          "backgroundColor": "#3991f6",
          "dark": {
            "image": "./assets/images/SplashIcon.png",
            "resizeMode": "contain",
            "backgroundColor": "#3991f6"
          },
          "imageWidth": 240
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow FinScholar to access your photos.",
          "savePhotosPermission": "Allow FinScholar to save photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-notifications",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Nunito_400Regular.ttf",
            "./assets/fonts/Nunito_700Bold.ttf",
            "./assets/fonts/Nunito_800ExtraBold.ttf"
          ],
          "widgets": [
            {
              "name": "FinScholarWidget",
              "label": "FinScholar · Up Next",
              "description": "The class you are in or heading to, plus what follows.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "320dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FinScholarAgendaWidget",
              "label": "FinScholar · Today",
              "description": "Every class on today's timetable, with what is left to go.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "400dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FinScholarDeadlinesWidget",
              "label": "FinScholar · Deadlines",
              "description": "Unfinished tasks, soonest due first, overdue in red.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "400dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FinScholarFocusWidget",
              "label": "FinScholar · Next Class",
              "description": "A single strip: what is next, where, and how long you have.",
              "minWidth": "180dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "110dp",
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FinScholarStatsWidget",
              "label": "FinScholar · Semester Pulse",
              "description": "Grade, attendance, open tasks and how far through the term you are.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "250dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-build-properties",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "googleWebClientId": "398238102082-q812a4ki3c7qg9mp19jqbpqq6hbv88ns.apps.googleusercontent.com",
      "eas": {
        "projectId": "5fd95516-0198-488d-aea9-a8db7155435c"
      }
    }
  }
}
