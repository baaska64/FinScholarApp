{
  "expo": {
    "name": "FinScholarApp",
    "slug": "FinScholarApp",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/FinScholarAppLogo.png",
    "scheme": "finscholarapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/FinScholarAppLogo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "com.android.vending.BILLING"
      ],
      "package": "com.lalex.finscholar",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/FinScholarAppLogo.png",
          "resizeMode": "contain",
          "backgroundColor": "#f8fafc",
          "dark": {
            "image": "./assets/images/FinScholarAppLogo.png",
            "resizeMode": "contain",
            "backgroundColor": "#0f172a"
          },
          "imageWidth": 128,
          "imageHeight": 128
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow FinScholar to access your photos.",
          "savePhotosPermission": "Allow FinScholar to save photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-notifications",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "FinScholarWidget",
              "label": "FinScholar Next Class",
              "minWidth": "180dp",
              "minHeight": "80dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5fd95516-0198-488d-aea9-a8db7155435c"
      }
    }
  }
}
